<Project>
  <PropertyGroup>
    <PackageIcon>bitbug_favicon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- 统一输出到仓库根 release/，任意深度子项目均可正确解析 -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)release</PackageOutputPath>
    <!-- 默认不发包；仅 pack/*.csproj 显式 IsPackable=true -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- 使用 MSBuildThisFileDirectory，避免深层目录下相对路径失效 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)packfile\bitbug_favicon.png" Visible="false" Pack="true" Condition="Exists('$(MSBuildThisFileDirectory)packfile\bitbug_favicon.png')">
      <PackagePath></PackagePath>
    </None>
    <None Include="$(MSBuildThisFileDirectory)packfile\readme.md" Link="readme.md" Pack="true" PackagePath="/" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)packfile\readme.md')" />
  </ItemGroup>
</Project>

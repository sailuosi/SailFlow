<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>sailflow.data</PackageId>
    <RootNamespace>sailflow.data</RootNamespace>
    <AssemblyName>sailflow.data</AssemblyName>
    <Description>Sailflow data lifecycle: hot/cold archive, cold store, table log sink, data-management hooks.</Description>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\pure\engine\sailflow.engine.csproj" />
  </ItemGroup>

</Project>

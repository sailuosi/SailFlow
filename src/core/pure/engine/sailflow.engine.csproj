  <!-- Bundle Package Strategy -->
  <!-- In development: Use ProjectReference for faster builds -->
  <!-- When packing: Script will convert ProjectReference to PackageReference -->
  <!-- This allows saiflow.engine to depend on other packages instead of including assemblies -->
  
  <!-- Note: The pack-bundle.ps1 script will temporarily convert ProjectReference to PackageReference during packing -->

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <PackageId>sailflow.runtime</PackageId>
    <RootNamespace>sailflow.runtime</RootNamespace>
    <AssemblyName>sailflow.runtime</AssemblyName>
    <Description>
      Engine default pluggable implementations (no heavy NuGet): LINQ condition evaluator, GuidString Id source / BPMN codec, etc.
      Depends on sailflow.engine only. Assignee remains sailflow.assignee until migrated here.
    </Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\engine\sailflow.engine.csproj" />
  </ItemGroup>

</Project>

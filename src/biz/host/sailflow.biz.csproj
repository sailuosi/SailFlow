<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>saiflow.biz</PackageId>
    <RootNamespace>saiflow.biz</RootNamespace>
    <AssemblyName>saiflow.biz</AssemblyName>
    <Description>Sailflow business composition root: schema bootstrap, AI runtime registration, and biz feature packages (docs/AI/query).</Description>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\pure\engine\sailflow.engine.csproj" />
    <ProjectReference Include="..\..\core\ext\action\sailflow.action.csproj" />
    <ProjectReference Include="..\..\core\ext\msg\sailflow.msg.csproj" />
    <ProjectReference Include="..\..\core\ext\bizRule\sailflow.bizRule.csproj" />


    <ProjectReference Include="..\..\core\ext\resource\sailflow.resource.csproj" />
    <ProjectReference Include="..\..\core\ext\localize\sailflow.localize.csproj" />
    <ProjectReference Include="..\..\core\ext\form\sailflow.form.csproj" />
    <ProjectReference Include="..\AI\sailflow.biz.AI.csproj" />
    <ProjectReference Include="..\docs\sailflow.biz.docs.csproj" />
    <ProjectReference Include="..\query\sailflow.biz.query.csproj" />
  </ItemGroup>

</Project>

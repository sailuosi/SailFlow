<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <RootNamespace>sailflow.hub.External</RootNamespace>
    <AssemblyName>sailflow.hub.External.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <ProjectReference Include="..\sailflow.data\sailflow.data.csproj" />
    <ProjectReference Include="..\sailflow.engine\sailflow.engine.csproj" />
    <ProjectReference Include="..\sailflow.hub.External\sailflow.hub.External.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

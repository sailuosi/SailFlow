<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>sailflow.pure</PackageId>
    <AssemblyName>sailflow.pure</AssemblyName>
    <RootNamespace>sailflow.pure</RootNamespace>
    <Description>sailflow pure layer aggregator: basis, baseHub, AI, engine, assignee, runtime. Depends on mooSQL.Ext.</Description>
    <PackageTags>sailflow;workflow;pure</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!--
    发布依赖：叶子工程编译仍用本地 mooSQL ProjectReference；
    聚合包须显式 PackageReference，否则 PrivateAssets=all 不会把 mooSQL 写进 nuspec。
  -->
  <ItemGroup>
    <PackageReference Include="mooSQL.Ext" Version="8.2.1.13" />
  </ItemGroup>

  <!-- Layer assemblies → packed into this nupkg; not separate NuGet deps -->
  <ItemGroup>
    <ProjectReference Include="..\src\core\pure\basis\sailflow.basis.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\baseHub\sailflow.baseHub.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\AI\sailflow.AI.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\engine\sailflow.engine.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\assignee\sailflow.assignee.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\runtime\sailflow.runtime.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Pack.targets" />

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>sailflow.biz</PackageId>
    <AssemblyName>sailflow.biz.pack</AssemblyName>
    <RootNamespace>sailflow.biz.pack</RootNamespace>
    <Description>sailflow biz layer aggregator: host composition root, AI, docs, query. Depends on sailflow.ext.</Description>
    <PackageTags>sailflow;workflow;biz</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Cross-layer + leaf third-party deps (PrivateAssets=all ProjectRefs do not flow PackageReferences) -->
  <ItemGroup>
    <PackageReference Include="sailflow.ext" Version="$(VersionPrefix)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
    <PackageReference Include="iTextSharp" Version="5.5.13.4" />
  </ItemGroup>

  <!-- Layer assemblies → packed into this nupkg
       Note: host AssemblyName is saiflow.biz; pack facade uses sailflow.biz.pack to avoid collision. -->
  <ItemGroup>
    <ProjectReference Include="..\src\biz\host\sailflow.biz.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\biz\AI\sailflow.biz.AI.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\biz\docs\sailflow.biz.docs.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\biz\query\sailflow.biz.query.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Pack.targets" />

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>saiflow.pure</PackageId>
    <AssemblyName>saiflow.pure</AssemblyName>
    <RootNamespace>saiflow.pure</RootNamespace>
    <Description>saiflow pure layer aggregator: basis, baseHub, AI, engine, assignee. Depends on mooSQL.Ext.</Description>
    <PackageTags>saiflow;sailflow;workflow;pure</PackageTags>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Published dependency; leaf projects keep local mooSQL ProjectReference for compile. -->
  <ItemGroup>
    <PackageReference Include="mooSQL.Ext" Version="8.2.1.10" />
  </ItemGroup>

  <!-- Layer assemblies → packed into this nupkg; not separate NuGet deps -->
  <ItemGroup>
    <ProjectReference Include="..\src\core\pure\basis\sailflow.basis.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\baseHub\sailflow.baseHub.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\AI\sailflow.AI.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\engine\sailflow.engine.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\src\core\pure\assignee\sailflow.assignee.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Pack.targets" />

</Project>
